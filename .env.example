# Copy to .env and fill in. Never commit .env.

# --- Database ---
NEO4J_PASSWORD=change-this-password
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M
REDIS_MAXMEMORY=512mb

# --- Language model (Ollama runs on the host, not in Docker) ---
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT=180
LLM_CONTEXT=8192

# --- Telegram ---
# From BotFather. Leave blank to run without Telegram.
TELEGRAM_BOT_TOKEN=
# Numeric user id allowed to run /investigate and approve findings.
# Anyone else gets a polite refusal. Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_ID=
# Public channel for approved findings, e.g. @yourchannel. Optional.
TELEGRAM_CHANNEL_ID=

# --- Crawl and processing ---
CRAWL_INTERVAL_SECONDS=180
MAX_DOCS_PER_SWEEP=400
LLM_DAILY_LIMIT=0
EXTRACT_MIN_CHARS=280

# --- Network binding ---
# 127.0.0.1 keeps ports on the machine. The cloudflared tunnel connects to
# loopback, so it still works and nothing is exposed on the LAN.
API_BIND=127.0.0.1
API_PORT=8080
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- Public site ---
SITE_NAME=KhojAI
# Comma separated origins allowed to call the API. Set your tunnel hostname
# here before going public, for example https://khoj.example.com
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=60
# Set to true only when the site sits behind the Cloudflare tunnel.
TRUST_PROXY_HEADER=false
